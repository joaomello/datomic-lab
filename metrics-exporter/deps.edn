{:paths ["src"]
 :deps {io.prometheus/prometheus-metrics-core {:mvn/version "1.8.0"}
        io.prometheus/prometheus-metrics-instrumentation-jvm {:mvn/version "1.8.0"}
        io.prometheus/prometheus-metrics-exporter-httpserver {:mvn/version "1.8.0"}}
 :aliases
 {:build {:deps        {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default  build}
  :dev   {:extra-paths ["test"]
          :extra-deps  {org.clojure/clojure {:mvn/version "1.12.5"}}}
  ;; clojure -M:dev:test
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts   ["-m" "cognitect.test-runner"]}}}
