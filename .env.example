# Datomic lab configuration, read by build.sh and start.sh.
#
# This file is the documented template; ./build.sh copies it to .env on first
# run and records DATOMIC_HOME there. .env is gitignored, this file is tracked.
# Every value below is commented out and shows the default from
# scripts/common.sh -- uncomment only what you want to change.
#
# Explicit environment variables always win over values set here.

# Absolute path to the Datomic Pro installation. ./build.sh writes this for you;
# set it by hand to point the lab at an installation you already have.
# DATOMIC_HOME=/absolute/path/to/datomic-pro

# Version used when ./build.sh downloads Datomic Pro into ./datomic-pro.
# DATOMIC_VERSION=1.0.7705

# Answer ./build.sh's prompt non-interactively:
#   DATOMIC_DOWNLOAD=1  download when no installation is configured
#   DATOMIC_CLEAN=1     delete an existing ./datomic-pro and download again
# DATOMIC_DOWNLOAD=1
# DATOMIC_CLEAN=1

# Where the downloaded ZIP is cached. Must be absolute.
# DATOMIC_DOWNLOAD_DIR=<repo>/.datomic

# Container tool for the observability stack: 'docker compose' or
# 'podman compose'. Autodetected when unset.
# DATOMIC_COMPOSE=docker compose

# Transactor properties file, used in place -- edit it and run
# ./transactor-restart.sh, no rebuild. Must be absolute.
# DATOMIC_TRANSACTOR_CONFIG=<repo>/config/transactor.properties

# Log directory Promtail bind-mounts read-only. Must be absolute.
# DATOMIC_LOG_PATH=$DATOMIC_HOME/log

# Datomic Console.
# DATOMIC_CONSOLE_PORT=8080
# DATOMIC_URI=datomic:dev://localhost:4334/

# JVM options. -Duser.timezone=UTC is required: Datomic's log timestamps carry
# no timezone and Promtail parses them as UTC.
# DATOMIC_JAVA_OPTS=-Xms1g -Xmx1g -XX:+UseG1GC -XX:MaxGCPauseMillis=50 -Duser.timezone=UTC
# DATOMIC_CONSOLE_JAVA_OPTS=-Xmx512m -Duser.timezone=UTC

# Seconds ./start.sh waits for every endpoint to become healthy.
# DATOMIC_START_TIMEOUT=180
